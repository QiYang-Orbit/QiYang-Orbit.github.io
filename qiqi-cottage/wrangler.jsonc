{
  "name": "qiqi-cottage",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "qiqi-cottage", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "migrations"}],
  "vars": {"OWNER_USERNAME": "qiqi"}
}
